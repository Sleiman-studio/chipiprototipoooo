<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Administrador - Chipilines Venezuela</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Pacifico&family=Dancing+Script:wght@600;700&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = { theme: { extend: {
    colors: { rosa: '#E8B4C8', cielo: '#A8D8EA', oro: '#D4AF37', crema: '#FDF8F5', tinta: '#2D2A32' },
    fontFamily: { sans: ['Quicksand','sans-serif'], display: ['Pacifico','cursive'], script: ['Dancing Script','cursive'] }
  }}}
</script>
<link rel="stylesheet" href="css/style.css">
</head>
<body class="bg-crema">

<div id="login-overlay" class="fixed inset-0 z-[999] bg-tinta/95 backdrop-blur-sm hidden items-center justify-center p-5" style="display:none">
  <div class="bg-white rounded-3xl p-8 max-w-sm w-full shadow-2xl">
    <div class="w-14 h-14 rounded-full bg-gradient-to-br from-rosa to-cielo flex items-center justify-center mx-auto mb-5"><span class="font-display text-white text-xl">C</span></div>
    <h1 class="font-display text-3xl text-center text-tinta mb-1">Panel admin</h1>
    <p class="text-center text-sm text-gray-500 mb-6">Acceso exclusivo del equipo Chipilines</p>
    <form onsubmit="loginAdmin(event)" class="space-y-4">
      <input id="admin-pass" type="password" placeholder="Contrasena" class="w-full bg-crema rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-rosa/40" required>
      <button type="submit" class="btn-primary w-full font-bold py-3 rounded-full">Entrar</button>
      <p class="text-center text-[11px] text-gray-400">Demo: <code class="bg-crema px-2 py-0.5 rounded">chipilines2024</code></p>
    </form>
    <a href="index.html" class="block text-center text-xs text-gray-400 mt-4 hover:text-tinta">&larr; Volver al sitio</a>
  </div>
</div>

<div class="flex min-h-screen">
  <aside class="admin-sidebar w-64 flex-shrink-0 hidden md:flex flex-col p-6">
    <div class="flex items-center gap-3 mb-10">
      <div class="w-10 h-10 rounded-full bg-gradient-to-br from-rosa to-cielo flex items-center justify-center"><span class="font-display text-white text-base">C</span></div>
      <div><p class="font-bold text-sm">Chipilines</p><p class="text-[10px] uppercase tracking-[0.2em] text-white/50">Admin</p></div>
    </div>
    <nav class="space-y-1 flex-1">
      <a href="#dashboard" class="admin-link active flex items-center gap-3 px-4 py-3 text-sm font-semibold">Dashboard</a>
      <a href="#pedidos" class="admin-link flex items-center gap-3 px-4 py-3 text-sm font-semibold">Cotizaciones</a>
      <a href="#catalogo" class="admin-link flex items-center gap-3 px-4 py-3 text-sm font-semibold">Catalogo</a>
      <a href="#inicio" class="admin-link flex items-center gap-3 px-4 py-3 text-sm font-semibold">Editar Inicio</a>
    </nav>
    <button onclick="logoutAdmin()" class="text-xs text-white/50 hover:text-rosa text-left px-4 py-2">Cerrar sesion</button>
  </aside>

  <main class="flex-1 p-5 md:p-10 max-w-6xl mx-auto w-full">
    <header class="mb-10">
      <p class="font-script text-2xl text-rosa mb-1">Bienvenida</p>
      <h1 class="font-display text-4xl text-tinta">Panel de control</h1>
    </header>

    <section id="dashboard" class="grid sm:grid-cols-3 gap-4 mb-12">
      <div class="bg-white rounded-2xl p-6 shadow-sm"><p class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-2">Cotizaciones totales</p><p id="stat-total" class="font-display text-4xl text-tinta">0</p></div>
      <div class="bg-white rounded-2xl p-6 shadow-sm"><p class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-2">Pendientes de precio</p><p id="stat-pendientes" class="font-display text-4xl text-rosa">0</p></div>
      <div class="bg-white rounded-2xl p-6 shadow-sm"><p class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-2">Facturas enviadas / Aceptadas</p><p id="stat-cotizados" class="font-display text-4xl text-cielo">0</p></div>
    </section>

    <section id="pedidos" class="mb-14">
      <h2 class="font-display text-3xl text-tinta mb-5">Cotizaciones recibidas</h2>
      <p class="text-sm text-gray-500 mb-6">Asigna precios a cada producto, guarda y luego genera la factura. El boton verde abre WhatsApp con el cliente y el link a su factura.</p>
      <div id="lista-pedidos" class="space-y-4"></div>
    </section>

    <section id="catalogo" class="mb-14">
      <h2 class="font-display text-3xl text-tinta mb-5">Gestion de catalogo</h2>
      <form id="form-nuevo-producto" class="bg-white rounded-2xl p-6 shadow-sm mb-6 grid md:grid-cols-2 gap-4">
        <div><label class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1 block">Nombre</label>
          <input id="np-nombre" class="w-full bg-crema rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-rosa/40" required></div>
        <div><label class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1 block">Categoria</label>
          <select id="np-categoria" class="w-full bg-crema rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-rosa/40">
            <option value="placas">Placas</option><option value="cuadros">Cuadros</option>
            <option value="adhesivos">Adhesivos</option><option value="papel-tapiz">Papel Tapiz</option>
            <option value="nombres">Nombres</option><option value="habitaciones">Habitaciones</option>
          </select></div>
        <div class="md:col-span-2"><label class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1 block">Descripcion</label>
          <input id="np-descripcion" class="w-full bg-crema rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-rosa/40"></div>
        <div class="md:col-span-2"><label class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1 block">URL de imagen</label>
          <input id="np-imagen" type="url" placeholder="https://..." class="w-full bg-crema rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-rosa/40"></div>
        <button type="submit" class="btn-primary font-bold py-3 rounded-full md:col-span-2">Anadir producto</button>
      </form>
      <div id="lista-productos-admin" class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4"></div>
    </section>

    <section id="inicio" class="mb-14">
      <h2 class="font-display text-3xl text-tinta mb-5">Editar pagina de inicio</h2>
      <form id="form-home" class="bg-white rounded-2xl p-6 shadow-sm grid gap-4">
        <div><label class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1 block">Titulo del hero</label>
          <input id="edit-hero-titulo" class="w-full bg-crema rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-rosa/40"></div>
        <div><label class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1 block">Subtitulo</label>
          <textarea id="edit-hero-subtitulo" rows="3" class="w-full bg-crema rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-rosa/40 resize-none"></textarea></div>
        <div><label class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1 block">URL de imagen principal</label>
          <input id="edit-hero-imagen" type="url" class="w-full bg-crema rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-rosa/40"></div>
        <button type="submit" class="btn-primary font-bold py-3 rounded-full">Guardar cambios</button>
      </form>
    </section>
  </main>
</div>

<script src="js/app.js"></script>
<script src="js/admin.js"></script>
</body>
</html>
