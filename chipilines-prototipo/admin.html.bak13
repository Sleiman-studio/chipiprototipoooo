<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Administrador - Chipilines Venezuela</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Pacifico&family=Dancing+Script:wght@600;700&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = { theme: { extend: {
    colors: { rosa: '#E8B4C8', cielo: '#A8D8EA', oro: '#D4AF37', crema: '#FDF8F5', tinta: '#2D2A32' },
    fontFamily: { sans: ['Quicksand','sans-serif'], display: ['Pacifico','cursive'], script: ['Dancing Script','cursive'] }
  }}}
</script>
<link rel="stylesheet" href="css/style.css">
<style>
  /* ---- Estilos del panel admin SPA ---- */
  .admin-main { transition: all .3s ease; }
  .admin-section { display: none; animation: fadeUp .3s ease forwards; }
  .admin-section.active { display: block; }
  .admin-link { cursor: pointer; }
  .admin-link.active { background: rgba(232, 180, 200, .22); color: var(--rosa); font-weight: 700; }
  .cliente-card { transition: all .25s ease; cursor: pointer; }
  .cliente-card:hover { transform: translateY(-2px); box-shadow: 0 12px 30px -12px rgba(45,42,50,.18); border-color: var(--rosa) !important; }
  .cliente-card.selected { border-color: var(--rosa) !important; background: #FFF9FB; }
  .cliente-avatar { width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: .95rem; }
  .badge-soft { font-size: .68rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; display: inline-flex; align-items: center; gap: 4px; }
  .badge-rosa { background: #FBE4EC; color: #B04C6E; }
  .badge-cielo { background: #E4F4FA; color: #2E7DA0; }
  .badge-oro { background: #FBF0D9; color: #8C6A1A; }
  .badge-verde { background: #DCFCE7; color: #166534; }
  .badge-amarillo { background: #FEF3C7; color: #854D0E; }
  .badge-morado { background: #EDE9FE; color: #5B21B6; }
  .badge-rojo { background: #FEE2E2; color: #991B1B; }
  .badge-gris { background: #F3F4F6; color: #4B5563; }
  .search-input { background: #fff; border: 1.5px solid rgba(45,42,50,.08); border-radius: 999px; padding: 10px 18px 10px 42px; font-size: .85rem; outline: none; transition: all .2s ease; width: 100%; }
  .search-input:focus { border-color: var(--rosa); box-shadow: 0 0 0 4px rgba(232,180,200,.15); }
  .filter-select { background: #fff; border: 1.5px solid rgba(45,42,50,.08); border-radius: 999px; padding: 10px 16px; font-size: .82rem; font-weight: 600; outline: none; }
  .filter-select:focus { border-color: var(--rosa); }
  /* Checkbox personalizado */
  .check-custom { appearance: none; width: 22px; height: 22px; border: 2px solid rgba(45,42,50,.2); border-radius: 6px; cursor: pointer; position: relative; transition: all .15s ease; flex-shrink: 0; }
  .check-custom:checked { background: var(--rosa); border-color: var(--rosa); }
  .check-custom:checked::after { content: ''; position: absolute; left: 6px; top: 2px; width: 6px; height: 11px; border: solid #fff; border-width: 0 2.5px 2.5px 0; transform: rotate(45deg); }
  /* Modal */
  .modal-backdrop { position: fixed; inset: 0; background: rgba(45,42,50,.55); backdrop-filter: blur(4px); z-index: 9998; display: none; align-items: center; justify-content: center; padding: 20px; }
  .modal-backdrop.show { display: flex; }
  .modal-card { background: #fff; border-radius: 1.75rem; max-width: 640px; width: 100%; max-height: 90vh; overflow-y: auto; animation: fadeUp .3s ease; }
  /* Barra flotante de seleccion masiva */
  .mass-bar { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%) translateY(120%); background: var(--tinta); color: #fff; padding: 12px 24px; border-radius: 999px; box-shadow: 0 20px 50px -15px rgba(45,42,50,.5); z-index: 9500; display: flex; align-items: center; gap: 16px; transition: transform .35s cubic-bezier(.2,.8,.2,1); }
  .mass-bar.show { transform: translateX(-50%) translateY(0); }
  /* Sidebar scroll */
  .sidebar-scroll { overflow-y: auto; max-height: calc(100vh - 180px); }
  .sidebar-scroll::-webkit-scrollbar { width: 6px; }
  .sidebar-scroll::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); border-radius: 999px; }
</style>

<!-- SEO / Open Graph / Twitter -->
<meta name="description" content="Panel de administracion interno.">
<meta name="author" content="Chipilines Venezuela">
<meta name="theme-color" content="#E8B4C8">
<link rel="canonical" href="https://tubular-cheesecake-d5c238.netlify.app/admin.html">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Chipilines Venezuela">
<meta property="og:title" content="Panel admin - Chipilines Venezuela">
<meta property="og:description" content="Panel de administracion interno.">
<meta property="og:url" content="https://tubular-cheesecake-d5c238.netlify.app/admin.html">
<meta property="og:image" content="https://tubular-cheesecake-d5c238.netlify.app/img/og-chipilines.png">
<meta property="og:locale" content="es_VE">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Panel admin - Chipilines Venezuela">
<meta name="twitter:description" content="Panel de administracion interno.">
</head>
<body class="bg-crema">
<a href="#main-content" class="skip-link">Saltar al contenido principal</a>

<!-- LOGIN OVERLAY -->
<div id="login-overlay" class="fixed inset-0 z-[999] bg-tinta/95 backdrop-blur-sm hidden items-center justify-center p-5" style="display:none">
  <div class="bg-white rounded-3xl p-8 max-w-sm w-full shadow-2xl">
    <div class="w-14 h-14 rounded-full bg-gradient-to-br from-rosa to-cielo flex items-center justify-center mx-auto mb-5"><span class="font-display text-white text-xl">C</span></div>
    <h1 class="font-display text-3xl text-center text-tinta mb-1">Panel admin</h1>
    <p class="text-center text-sm text-gray-500 mb-6">Acceso exclusivo del equipo Chipilines</p>
    <form onsubmit="loginAdmin(event)" class="space-y-4">
      <input id="admin-pass" type="password" placeholder="Contrasena" class="w-full bg-crema rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-rosa/40" required>
      <button type="submit" class="btn-primary w-full font-bold py-3 rounded-full">Entrar</button>
      <p class="text-center text-[11px] text-gray-400">Demo: <code class="bg-crema px-2 py-0.5 rounded">chipilines2024</code></p>
    </form>
    <a href="index.html" class="block text-center text-xs text-gray-400 mt-4 hover:text-tinta">&larr; Volver al sitio</a>
  </div>
</div>

<!-- DASHBOARD LAYOUT -->
<div class="flex min-h-screen">
  <!-- SIDEBAR -->
  <aside class="admin-sidebar w-64 flex-shrink-0 hidden md:flex flex-col p-5">
    <div class="flex items-center gap-3 mb-8 px-2">
      <div class="w-10 h-10 rounded-full bg-gradient-to-br from-rosa to-cielo flex items-center justify-center"><span class="font-display text-white text-base">C</span></div>
      <div><p class="font-bold text-sm">Chipilines</p><p class="text-[10px] uppercase tracking-[0.2em] text-white/50">Admin</p></div>
    </div>

    <p class="text-[10px] uppercase tracking-[0.2em] text-white/40 px-3 mb-2">Principal</p>
    <nav class="space-y-1 mb-6 sidebar-scroll">
      <a data-section="dashboard" class="admin-link active flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        Dashboard
      </a>
      <a data-section="pedidos" class="admin-link flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        Cotizaciones
        <span id="nav-badge-pedidos" class="ml-auto bg-rosa text-white text-[10px] font-bold px-2 py-0.5 rounded-full">0</span>
      </a>
      <a data-section="catalogo" class="admin-link flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
        Catalogo
      </a>
      <a data-section="inicio" class="admin-link flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
        Editar Inicio
      </a>
    </nav>

    <div class="mt-auto pt-4 border-t border-white/10">
      <a href="index.html" target="_blank" class="flex items-center gap-3 px-4 py-2.5 text-xs text-white/60 hover:text-rosa transition rounded-xl">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        Ver sitio
      </a>
      <button onclick="logoutAdmin()" class="w-full flex items-center gap-3 px-4 py-2.5 text-xs text-white/60 hover:text-rosa transition rounded-xl">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
        Cerrar sesion
      </button>
    </div>
  </aside>

  <!-- MAIN -->
  <main id="main-content" class="flex-1 max-w-7xl mx-auto w-full admin-main-content">

    <!-- ====== SECCION: DASHBOARD ====== -->
    <section id="section-dashboard" class="admin-section active">
      <header class="mb-8">
        <p class="font-script text-2xl text-rosa mb-1">Bienvenida</p>
        <h1 class="font-display text-4xl text-tinta">Panel de control</h1>
      </header>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-2xl p-6 shadow-sm">
          <div class="flex items-center justify-between mb-2">
            <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Total cotizaciones</p>
            <div class="w-8 h-8 rounded-lg bg-rosa/20 flex items-center justify-center">
              <svg class="w-4 h-4 text-rosa" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            </div>
          </div>
          <p id="stat-total" class="font-display text-4xl text-tinta">0</p>
        </div>
        <div class="bg-white rounded-2xl p-6 shadow-sm">
          <div class="flex items-center justify-between mb-2">
            <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Pendientes de precio</p>
            <div class="w-8 h-8 rounded-lg bg-yellow-100 flex items-center justify-center">
              <svg class="w-4 h-4 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
          </div>
          <p id="stat-pendientes" class="font-display text-4xl text-yellow-500">0</p>
        </div>
        <div class="bg-white rounded-2xl p-6 shadow-sm">
          <div class="flex items-center justify-between mb-2">
            <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Facturas enviadas</p>
            <div class="w-8 h-8 rounded-lg bg-cielo/30 flex items-center justify-center">
              <svg class="w-4 h-4 text-cielo" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
          </div>
          <p id="stat-cotizados" class="font-display text-4xl text-cielo">0</p>
        </div>
        <div class="bg-white rounded-2xl p-6 shadow-sm">
          <div class="flex items-center justify-between mb-2">
            <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Pagados</p>
            <div class="w-8 h-8 rounded-lg bg-green-100 flex items-center justify-center">
              <svg class="w-4 h-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
          </div>
          <p id="stat-pagados" class="font-display text-4xl text-green-500">0</p>
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-4 mb-8">
        <div class="bg-gradient-to-br from-rosa/20 to-rosa/5 rounded-2xl p-6">
          <p class="text-xs font-bold uppercase tracking-wider text-tinta/60 mb-2">Ingresos confirmados</p>
          <p id="stat-ingresos" class="font-display text-3xl text-tinta">$0.00</p>
        </div>
        <div class="bg-gradient-to-br from-cielo/20 to-cielo/5 rounded-2xl p-6">
          <p class="text-xs font-bold uppercase tracking-wider text-tinta/60 mb-2">Clientes unicos</p>
          <p id="stat-clientes" class="font-display text-3xl text-tinta">0</p>
        </div>
        <div class="bg-gradient-to-br from-oro/20 to-oro/5 rounded-2xl p-6">
          <p class="text-xs font-bold uppercase tracking-wider text-tinta/60 mb-2">Productos en catalogo</p>
          <p id="stat-productos" class="font-display text-3xl text-tinta">0</p>
        </div>
      </div>

      <div class="bg-white rounded-2xl p-6 shadow-sm">
        <h3 class="font-bold text-lg mb-4">Ultimas cotizaciones</h3>
        <div id="dash-ultimas"></div>
      </div>
    </section>

    <!-- ====== SECCION: COTIZACIONES ====== -->
    <section id="section-pedidos" class="admin-section">
      <header class="mb-6">
        <p class="font-script text-2xl text-rosa mb-1">Pedidos</p>
        <h1 class="font-display text-4xl text-tinta">Cotizaciones recibidas</h1>
        <p class="text-sm text-gray-500 mt-2">Asigna precios, genera la factura y gestiona el pago.</p>
      </header>

      <!-- Buscador y filtros -->
      <div class="bg-white rounded-2xl p-4 shadow-sm mb-5 flex flex-wrap gap-3 items-center">
        <div class="relative flex-1 min-w-[260px]">
          <svg class="w-4 h-4 absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input id="buscar-pedidos" type="text" class="search-input" placeholder="Buscar por nombre, cedula, telefono o codigo..." oninput="filtrarPedidos()">
        </div>
        <select id="filtro-estado" class="filter-select" onchange="filtrarPedidos()">
          <option value="todos">Todos los estados</option>
          <option value="pendiente">Pendientes de precio</option>
          <option value="cotizado">Factura enviada</option>
          <option value="aceptado">Aceptado (esperando pago)</option>
          <option value="pagado">Pagados</option>
          <option value="cancelado">Cancelados</option>
        </select>
        <select id="filtro-orden" class="filter-select" onchange="filtrarPedidos()">
          <option value="recientes">Mas recientes</option>
          <option value="antiguos">Mas antiguos</option>
          <option value="mayor-monto">Mayor monto</option>
        </select>
        <label class="flex items-center gap-2 text-xs font-bold text-gray-500 px-2 cursor-pointer select-none">
          <input type="checkbox" id="seleccionar-todos-pedidos" class="check-custom" onchange="toggleTodosPedidos(this)">
          Seleccionar todos
        </label>
        <button onclick="limpiarFiltrosPedidos()" class="filter-select hover:border-rosa transition">Limpiar</button>
        <span id="contador-pedidos" class="text-xs text-gray-400 font-semibold px-2"></span>
      </div>

      <div id="lista-pedidos" class="space-y-4"></div>
    </section>

    <!-- ====== SECCION: CATALOGO ====== -->
    <section id="section-catalogo" class="admin-section">
      <header class="mb-6">
        <p class="font-script text-2xl text-rosa mb-1">Productos</p>
        <h1 class="font-display text-4xl text-tinta">Gestion de catalogo</h1>
        <p class="text-sm text-gray-500 mt-2">Sube fotos, edita, elimina o selecciona varios para borrarlos en masa.</p>
      </header>

      <!-- Boton agregar + buscador -->
      <div class="bg-white rounded-2xl p-4 shadow-sm mb-5 flex flex-wrap gap-3 items-center">
        <div class="relative flex-1 min-w-[240px]">
          <svg class="w-4 h-4 absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input id="buscar-productos" type="text" class="search-input" placeholder="Buscar producto..." oninput="filtrarProductos()">
        </div>
        <select id="filtro-categoria-productos" class="filter-select" onchange="filtrarProductos()">
          <option value="todos">Todas las categorias</option>
          <option value="placas">Placas</option>
          <option value="cuadros">Cuadros</option>
          <option value="adhesivos">Adhesivos</option>
          <option value="papel-tapiz">Papel Tapiz</option>
          <option value="nombres">Nombres</option>
          <option value="habitaciones">Habitaciones</option>
        </select>
        <label class="flex items-center gap-2 text-xs font-bold text-gray-500 px-2 cursor-pointer select-none">
          <input type="checkbox" id="seleccionar-todos" class="check-custom" onchange="toggleTodosProductos(this)">
          Seleccionar todos
        </label>
        <button onclick="abrirModalProducto()" class="btn-primary text-xs font-bold px-5 py-2.5 rounded-full inline-flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Nuevo producto
        </button>
      </div>

      <div id="lista-productos-admin" class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"></div>
    </section>

    <!-- ====== SECCION: EDITAR INICIO ====== -->
    <section id="section-inicio" class="admin-section">
      <header class="mb-6">
        <p class="font-script text-2xl text-rosa mb-1">Personalizar</p>
        <h1 class="font-display text-4xl text-tinta">Editar pagina de inicio</h1>
        <p class="text-sm text-gray-500 mt-2">Cambia el titulo, subtitulo e imagen principal del hero.</p>
      </header>

      <form id="form-home" class="bg-white rounded-2xl p-6 shadow-sm grid gap-5 max-w-3xl">
        <div>
          <label class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-2 block">Titulo del hero</label>
          <input id="edit-hero-titulo" class="w-full bg-crema rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-rosa/40" placeholder="Creamos espacios magicos para tu bebe">
        </div>
        <div>
          <label class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-2 block">Subtitulo</label>
          <textarea id="edit-hero-subtitulo" rows="3" class="w-full bg-crema rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-rosa/40 resize-none"></textarea>
        </div>
        <div>
          <label class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-2 block">Imagen principal del inicio</label>
          <div id="hero-upload" class="upload-zone" onclick="abrirSelectorImagen('hero')">
            <input type="file" id="hero-file" accept="image/*" style="display:none" onchange="cargarImagenHero(this)">
            <div class="upload-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
            <div class="upload-text">Toca para subir o arrastra una foto aqui</div>
            <div class="upload-hint">JPG, PNG o WEBP - Se comprime automaticamente</div>
          </div>
        </div>
        <div class="flex gap-3">
          <button type="submit" class="btn-primary font-bold py-3 px-6 rounded-full">Guardar cambios</button>
          <button type="button" onclick="previewHome()" class="btn-ghost font-bold py-3 px-6 rounded-full">Ver preview</button>
        </div>
      </form>
    </section>
  </main>
</div>

<!-- MODAL: PRODUCTO (nuevo/editar) -->
<div id="modal-producto" class="modal-backdrop" onclick="if(event.target===this) cerrarModalProducto()">
  <div class="modal-card p-6 md:p-8">
    <div class="flex items-center justify-between mb-6">
      <h2 id="modal-producto-titulo" class="font-display text-3xl text-tinta">Nuevo producto</h2>
      <button onclick="cerrarModalProducto()" class="w-10 h-10 rounded-full bg-crema flex items-center justify-center hover:bg-rosa/20 transition">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <form id="form-producto" onsubmit="guardarProducto(event)" class="grid gap-5">
      <input type="hidden" id="np-id">
      <div>
        <label class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-2 block">Nombre</label>
        <input id="np-nombre" class="w-full bg-crema rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-rosa/40" required>
      </div>
      <div>
        <label class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-2 block">Categoria</label>
        <select id="np-categoria" class="w-full bg-crema rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-rosa/40">
          <option value="placas">Placas</option>
          <option value="cuadros">Cuadros</option>
          <option value="adhesivos">Adhesivos</option>
          <option value="papel-tapiz">Papel Tapiz</option>
          <option value="nombres">Nombres</option>
          <option value="habitaciones">Habitaciones</option>
        </select>
      </div>
      <div>
        <label class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-2 block">Descripcion</label>
        <textarea id="np-descripcion" rows="3" class="w-full bg-crema rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-rosa/40 resize-none"></textarea>
      </div>
      <div>
        <label class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-2 block">Imagen del producto</label>
        <div id="np-upload" class="upload-zone" onclick="abrirSelectorImagen('np')">
          <input type="file" id="np-file" accept="image/*" style="display:none" onchange="cargarImagenProducto(this)">
          <div class="upload-icon">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <div class="upload-text">Toca para subir o arrastra una foto aqui</div>
          <div class="upload-hint">JPG, PNG o WEBP - Se comprime automaticamente</div>
        </div>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="submit" class="btn-primary font-bold py-3 px-6 rounded-full flex-1">Guardar producto</button>
        <button type="button" onclick="cerrarModalProducto()" class="btn-ghost font-bold py-3 px-6 rounded-full">Cancelar</button>
      </div>
    </form>
  </div>
</div>

<!-- BARRA FLOTANTE DE SELECCION MASIVA -->
<div id="mass-bar" class="mass-bar">
  <span id="mass-count" class="text-sm font-bold">0 seleccionados</span>
  <button onclick="borrarSeleccionados()" class="bg-rosa hover:bg-rosa/80 text-white text-xs font-bold px-4 py-2 rounded-full transition inline-flex items-center gap-2">
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
    Borrar seleccionados
  </button>
  <button onclick="deseleccionarTodos()" class="text-white/60 hover:text-white text-xs font-bold transition">Cancelar</button>
</div>

<!-- BARRA FLOTANTE DE SELECCION MASIVA (PEDIDOS) -->
<div id="mass-bar-pedidos" class="mass-bar">
  <span id="mass-count-pedidos" class="text-sm font-bold">0 seleccionados</span>
  <button onclick="borrarPedidosSeleccionados()" class="bg-rosa hover:bg-rosa/80 text-white text-xs font-bold px-4 py-2 rounded-full transition inline-flex items-center gap-2">
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
    Borrar seleccionadas
  </button>
  <button onclick="deseleccionarTodosPedidos()" class="text-white/60 hover:text-white text-xs font-bold transition">Cancelar</button>
</div>
<script src="https://cdn.jsdelivr.net/npm/lz-string@1.5.0/libs/lz-string.min.js"></script>
<script src="js/app.js"></script>
<script src="js/admin.js"></script>
</body>
</html>
