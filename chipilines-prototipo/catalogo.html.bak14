<body class="bg-crema">
<a href="#main-content" class="skip-link">Saltar al contenido principal</a>

<nav class="navbar fixed top-0 left-0 right-0 z-50">
  <div class="max-w-7xl mx-auto px-5 md:px-8 h-20 flex items-center justify-between">
    <a href="index.html" class="flex items-center gap-3">
      <div class="w-11 h-11 rounded-full bg-gradient-to-br from-rosa to-cielo flex items-center justify-center shadow-md"><span class="font-display text-white text-lg">C</span></div>
      <div class="leading-none"><p class="font-bold text-lg tracking-tight">Chipilines</p><p class="text-[10px] uppercase tracking-[0.25em] text-gray-500">Venezuela</p></div>
    </a>
    <div class="hidden md:flex items-center gap-8 text-sm font-semibold">
      <a href="index.html" class="text-gray-500 hover:text-tinta transition">Inicio</a>
      <a href="catalogo.html" class="text-tinta">Catalogo</a>
      <a href="index.html#como" class="text-gray-500 hover:text-tinta transition">Como cotizar?</a>
      <a href="admin.html" class="text-gray-500 hover:text-tinta transition">Admin</a>
    </div>
    <div class="flex items-center gap-3">
      <a href="carrito.html" class="relative w-11 h-11 rounded-full bg-white shadow-sm flex items-center justify-center hover:shadow-md transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
        <span class="cart-badge cart-count" style="display:none">0</span>
      </a>
    </div>
  </div>
</nav>

<header class="pt-32 pb-10 px-5 md:px-8 max-w-7xl mx-auto reveal">
  <p class="font-script text-3xl text-rosa mb-2">Catalogo</p>
  <h1 class="font-display text-5xl md:text-6xl text-tinta mb-4">Elige y cotiza</h1>
  <p class="text-gray-500 max-w-2xl">Selecciona los productos que te gustaria cotizar. No veras precios aqui: armamos una cotizacion personalizada segun tu idea.</p>
</header>

<section class="px-5 md:px-8 max-w-7xl mx-auto mb-10">
  <div id="pills" class="flex flex-wrap gap-2 reveal"></div>
</section>

<section class="px-5 md:px-8 max-w-7xl mx-auto pb-24">
  <div id="grid-productos" class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"></div>
</section>

<footer class="bg-tinta text-white/60 py-8 text-center text-xs">(c) 2024 Chipilines Venezuela - Prototipo demostrativo</footer>

<a href="carrito.html" class="cart-float">
  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
  <span class="cart-badge cart-count" style="display:none">0</span>
</a>

<script src="js/app.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const pillsCont = document.getElementById('pills');
    pillsCont.innerHTML = CATEGORIAS.map((c, i) =>
      '<button class="pill ' + (i === 0 ? 'active' : '') + ' text-sm font-semibold px-5 py-2 rounded-full" data-cat="' + c.id + '">' + c.label + '</button>'
    ).join('');
    renderCatalogo('grid-productos', 'todos');
    pillsCont.querySelectorAll('button').forEach(btn => {
      btn.addEventListener('click', () => {
        pillsCont.querySelectorAll('button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        renderCatalogo('grid-productos', btn.dataset.cat);
      });
    });
  });
</script>
</body>
</html>
