function getHomeConfig() {
  const raw = localStorage.getItem('chipilines_home_v2');
  if (raw) {
    try { return JSON.parse(raw); } catch(e) {}
  }
  return JSON.parse(JSON.stringify(HOME_DEFAULT));
}

function saveHomeConfig(cfg) {
  localStorage.setItem('chipilines_home_v2', JSON.stringify(cfg));
}

function cargarHomeEditor() {
  const cfg = getHomeConfig();
  // Hero
  const el = (id) => document.getElementById(id);
  if (el('home-hero-badge')) el('home-hero-badge').value = cfg.hero.badge || '';
  if (el('home-hero-titulo')) el('home-hero-titulo').value = cfg.hero.titulo || '';
  if (el('home-hero-subtitulo')) el('home-hero-subtitulo').value = cfg.hero.subtitulo || '';
  if (cfg.hero.imagen) {
    window.__imgHomeHero = cfg.hero.imagen;
    setTimeout(() => pintarPreviewUpload('home-hero-upload', cfg.hero.imagen), 100);
  }
  (cfg.hero.stats || []).forEach((s, i) => {
    if (el('home-stat-' + (i+1) + '-num')) el('home-stat-' + (i+1) + '-num').value = s.num || '';
    if (el('home-stat-' + (i+1) + '-label')) el('home-stat-' + (i+1) + '-label').value = s.label || '';
  });
  // Servicios
  if (el('home-serv-tagline')) el('home-serv-tagline').value = cfg.servicios.tagline || '';
  if (el('home-serv-titulo')) el('home-serv-titulo').value = cfg.servicios.titulo || '';
  if (el('home-serv-desc')) el('home-serv-desc').value = cfg.servicios.descripcion || '';
  (cfg.servicios.items || []).forEach((it, i) => {
    const n = i + 1;
    if (el('home-serv-' + n + '-icono')) el('home-serv-' + n + '-icono').value = it.icono || '';
    if (el('home-serv-' + n + '-titulo')) el('home-serv-' + n + '-titulo').value = it.titulo || '';
    if (el('home-serv-' + n + '-desc')) el('home-serv-' + n + '-desc').value = it.descripcion || '';
  });
  // Pasos
  if (el('home-pasos-tagline')) el('home-pasos-tagline').value = cfg.pasos.tagline || '';
  if (el('home-pasos-titulo')) el('home-pasos-titulo').value = cfg.pasos.titulo || '';
  (cfg.pasos.items || []).forEach((it, i) => {
    const n = i + 1;
    if (el('home-paso-' + n + '-titulo')) el('home-paso-' + n + '-titulo').value = it.titulo || '';
    if (el('home-paso-' + n + '-desc')) el('home-paso-' + n + '-desc').value = it.descripcion || '';
  });
  // CTA
  if (el('home-cta-titulo')) el('home-cta-titulo').value = cfg.cta.titulo || '';
  if (el('home-cta-subtitulo')) el('home-cta-subtitulo').value = cfg.cta.subtitulo || '';
  if (el('home-cta-boton')) el('home-cta-boton').value = cfg.cta.boton || '';
  // Footer
  if (el('home-footer-desc')) el('home-footer-desc').value = cfg.footer.descripcion || '';
  if (el('home-footer-ubicacion')) el('home-footer-ubicacion').value = cfg.footer.ubicacion || '';
  if (el('home-footer-telefono')) el('home-footer-telefono').value = cfg.footer.telefono || '';
}

function recolectarHome() {
  const el = (id) => document.getElementById(id);
  const val = (id) => (el(id) ? el(id).value : '');
  const cfg = {
    hero: {
      badge: val('home-hero-badge'),
      titulo: val('home-hero-titulo'),
      subtitulo: val('home-hero-subtitulo'),
      imagen: window.__imgHomeHero || '',
      stats: [
        { num: val('home-stat-1-num'), label: val('home-stat-1-label') },
        { num: val('home-stat-2-num'), label: val('home-stat-2-label') },
        { num: val('home-stat-3-num'), label: val('home-stat-3-label') }
      ]
    },
    servicios: {
      tagline: val('home-serv-tagline'),
      titulo: val('home-serv-titulo'),
      descripcion: val('home-serv-desc'),
      items: [1,2,3,4].map(n => ({
        icono: val('home-serv-' + n + '-icono'),
        titulo: val('home-serv-' + n + '-titulo'),
        descripcion: val('home-serv-' + n + '-desc')
      }))
    },
    pasos: {
      tagline: val('home-pasos-tagline'),
      titulo: val('home-pasos-titulo'),
      items: [1,2,3].map(n => ({
        titulo: val('home-paso-' + n + '-titulo'),
        descripcion: val('home-paso-' + n + '-desc')
      }))
    },
    cta: {
      titulo: val('home-cta-titulo'),
      subtitulo: val('home-cta-subtitulo'),
      boton: val('home-cta-boton')
    },
    footer: {
      descripcion: val('home-footer-desc'),
      ubicacion: val('home-footer-ubicacion'),
      telefono: val('home-footer-telefono')
    }
  };
  return cfg;
}

function guardarTodoHome() {
  const cfg = recolectarHome();
  saveHomeConfig(cfg);
  mostrarToast('Cambios guardados. Mira el preview!');
}

async function cargarImagenHomeHero(input) {
  if (!input.files || !input.files[0]) return;
  try {
    mostrarToast('Procesando imagen...');
    const dataUrl = await comprimirImagen(input.files[0], 1400, 0.82);
    window.__imgHomeHero = dataUrl;
    pintarPreviewUpload('home-hero-upload', dataUrl);
    mostrarToast('Imagen lista');
  } catch(e) { mostrarToast(e.message || 'Error al cargar', 'error'); }
}

function previewHome() {
  // Guardar los cambios temporalmente para que el preview los muestre
  const cfg = recolectarHome();
  saveHomeConfig(cfg);
  window.open('index.html?preview=1', '_blank');
  mostrarToast('Vista previa abierta');
}
